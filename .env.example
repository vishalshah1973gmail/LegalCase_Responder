# Copy this file to .env and fill in your key. Never commit .env.
# (On Streamlit Community Cloud use the Secrets panel instead — see
#  .streamlit/secrets.toml.example and the Deployment section of the README.)
ANTHROPIC_API_KEY=

# Optional overrides
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=1500
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Embedding backend: auto | sentence-transformers | onnx
#   auto  -> sentence-transformers if installed, else onnx  (recommended locally)
#   onnx  -> ChromaDB's bundled ONNX MiniLM; no PyTorch, needed on Streamlit Cloud
EMBEDDING_BACKEND=auto

# Set true on an ephemeral host to ship a prebuilt index and disable ingestion
READ_ONLY=

# Shared password to open the app. Leave blank for no gate.
APP_PASSWORD=

# Optional: raises the rate limit for ingestion/fetch_real.py (free to obtain)
COURTLISTENER_TOKEN=
