# Streamlit Community Cloud: paste this content into
#   App menu -> Settings -> Secrets
# Locally: copy to .streamlit/secrets.toml (git-ignored) or keep using .env.

ANTHROPIC_API_KEY = "sk-ant-..."
ANTHROPIC_MODEL   = "claude-sonnet-5"

# Shared password required to open the app. Remove the line to make it public.
APP_PASSWORD = "change-me"

# Ephemeral host: ship the prebuilt index and disable ingestion in the UI.
READ_ONLY = "true"

# Force the light embedding backend on the cloud ("auto" | "onnx" | "sentence-transformers")
EMBEDDING_BACKEND = "onnx"
